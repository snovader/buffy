{
  "name": "buffy-typescript",
  "private": true,
  "type": "module",
  "workspaces": [
    "benchmarks",
    "core"
  ],
  "scripts": {
    "bench": "vitest bench --run --reporter=verbose",
    "bench:compare": "node --conditions=@buffy/source benchmarks/comparison/main.ts",
    "conformance:generate": "node --conditions=@buffy/source core/test/conformance/generate.ts && node --conditions=@buffy/source core/test/generated/generate.ts",
    "format:check": "biome format .",
    "format:write": "yarn format:check --write",
    "lint:check": "biome lint .",
    "lint:write": "yarn lint:check --write",
    "package:check": "yarn workspace @buffy/core pack -o ../.cache/buffy-core.tgz && attw --profile esm-only .cache/buffy-core.tgz && publint core && node core/test/dist.ts",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
