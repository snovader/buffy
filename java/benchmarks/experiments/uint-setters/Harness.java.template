package experiment;

import com.sun.management.ThreadMXBean;
import java.io.*;
import java.lang.management.ManagementFactory;
import java.nio.ByteOrder;
import java.util.*;

/** Dedicated loops for each variant, width and calling context. */
public final class Harness {
    private static volatile Object sink;
    private static final ThreadMXBean ALLOCATION = (ThreadMXBean) ManagementFactory.getThreadMXBean();
    private static final long THREAD = Thread.currentThread().threadId();
    private static final long[] EDGES = {0, 1, 127, 128, 255, 256, 32767, 32768, 65535, 65536,
        0x7fff_ffffL, 0x8000_0000L, 0xffff_ffffL, 0x1_0000_0000L, -1, Long.MIN_VALUE, Long.MAX_VALUE};

    private interface Timer {
        long run(int iterations);
    }

    private record Task(String variant, String operation, int rows, Timer timer) {}

    public static void main(String[] args) throws IOException {
        Locale.setDefault(Locale.ROOT);
        System.out.printf("JDK %s; %s; %s%n", System.getProperty("java.runtime.version"),
            System.getProperty("os.arch"), ByteOrder.nativeOrder());
        if (!Boolean.getBoolean("experiment.skipValidation") || Boolean.parseBoolean(args[0])) {
VALIDATE
            System.out.println("PASS: uint8/16/32 bytes, round trips, truncation, empty arrays, offsets, following fields, short buffers and tables");
        }
        if (Boolean.parseBoolean(args[0])) {
            return;
        }
        ALLOCATION.setThreadAllocatedMemoryEnabled(true);
        var variant = Objects.requireNonNull(System.getProperty("experiment.worker"));
        var tasks = new ArrayList<Task>();
        for (int rows : new int[]{100, 100_000}) {
REGISTER
        }
        var selected = tasks.stream().filter(t -> t.variant.equals(variant)).toList();
        var input = new BufferedReader(new InputStreamReader(System.in));
        System.out.println("READY");
        for (String line; (line = input.readLine()) != null;) {
            var command = line.split(" ");
            int rows = Integer.parseInt(command[0]);
            String operation = command[1];
            int iterations = Integer.parseInt(command[2]);
            var task = selected.stream().filter(t -> t.rows == rows && t.operation.equals(operation)).findFirst().orElseThrow();
            long collections = gcCount();
            long gcMillis = gcTime();
            long allocated = ALLOCATION.getThreadAllocatedBytes(THREAD);
            long elapsed = task.timer.run(iterations);
            allocated = ALLOCATION.getThreadAllocatedBytes(THREAD) - allocated;
            System.out.printf("SAMPLE,%d,%d,%d,%d%n", elapsed, allocated, gcCount() - collections, gcTime() - gcMillis);
        }
    }

    private static long gcCount() {
        return ManagementFactory.getGarbageCollectorMXBeans().stream().mapToLong(b -> Math.max(0, b.getCollectionCount())).sum();
    }

    private static long gcTime() {
        return ManagementFactory.getGarbageCollectorMXBeans().stream().mapToLong(b -> Math.max(0, b.getCollectionTime())).sum();
    }

    private static void require(boolean condition) {
        if (!condition) {
            throw new AssertionError("Incorrect variant result");
        }
    }

// BEGIN KERNEL
    private static void register_VARIANT_WIDTH(List<Task> tasks, int rows) {
        var random = new Random(rows);
        var values = new TYPE[rows];
        long mask = (1L << WIDTH) - 1;
        for (int i = 0; i < values.length; i++) {
            values[i] = (TYPE) (random.nextLong() & mask);
        }
        tasks.add(new Task("VARIANT", "uintWIDTH_array_write", rows, n -> arrayWrite_VARIANT_WIDTH(values, n)));
        tasks.add(new Task("VARIANT", "uintWIDTH_table_write", rows, n -> tableWrite_VARIANT_WIDTH(values, n)));
    }

    private static long arrayWrite_VARIANT_WIDTH(TYPE[] values, int iterations) {
        long start = System.nanoTime();
        for (int i = 0; i < iterations; i++) {
            var buffer = experiment.VARIANT.ByteBuffer.allocate(4 + values.length * (WIDTH / 8));
            buffer.setUintWIDTHArray(values);
            sink = buffer.bytes();
        }
        return System.nanoTime() - start;
    }

    private static long tableWrite_VARIANT_WIDTH(TYPE[] values, int iterations) {
        long start = System.nanoTime();
        for (int i = 0; i < iterations; i++) {
            sink = table_VARIANT_WIDTH(values);
        }
        return System.nanoTime() - start;
    }

    private static byte[] table_VARIANT_WIDTH(TYPE[] values) {
        var table = new experiment.VARIANT.TableBuilder(3);
        table.setInt64(42);
        table.setUintWIDTHArray(values);
        table.setFloat64(1.5);
        return table.bytes();
    }

    private static void validate_VARIANT_WIDTH() {
        var random = new Random(0x32);
        for (var width : experiment.VARIANT.AddressableSpace.values()) {
            var layout = experiment.VARIANT.TableLayout.builder().offsetSize(width).build();
            for (int length = 0; length <= 65; length++) {
                var values = new TYPE[length];
                var expected = new TYPE[length];
                for (int i = 0; i < length; i++) {
                    values[i] = (TYPE) (i < EDGES.length ? EDGES[i] : random.nextLong());
                    expected[i] = (TYPE) (values[i] & ((1L << WIDTH) - 1));
                }
                // Independent byte oracle, with an unaligned prefix and a following marker.
                var oracle = java.nio.ByteBuffer.allocate(1 + width.valueOf() + (WIDTH / 8) * length + 4).order(ByteOrder.LITTLE_ENDIAN);
                oracle.put((byte) 42);
                for (int b = 0; b < width.valueOf(); b++) {
                    oracle.put((byte) (length >>> (8 * b)));
                }
                for (long value : values) {
                    for (int b = 0; b < WIDTH / 8; b++) {
                        oracle.put((byte) (value >>> (8 * b)));
                    }
                }
                oracle.putInt(0x12345678);
                var buffer = new experiment.VARIANT.ByteBuffer(new byte[oracle.capacity()], layout);
                buffer.setInt8((byte) 42);
                buffer.setUintWIDTHArray(values);
                buffer.setInt32(0x12345678);
                require(Arrays.equals(buffer.bytes(), oracle.array()));
                require(Arrays.equals(buffer.getUintWIDTHArray(1), expected));

                if (!Boolean.getBoolean("experiment.skipFailureChecks")) {
                    var shortBytes = new byte[width.valueOf() + (WIDTH / 8) * length - 1];
                    var tooShort = new experiment.VARIANT.ByteBuffer(shortBytes, layout);
                    try {
                        tooShort.setUintWIDTHArray(values);
                        throw new AssertionError("Short buffer accepted");
                    } catch (IndexOutOfBoundsException expectedError) {
                        require(Arrays.equals(shortBytes, new byte[shortBytes.length]));
                    }
                }
            }
        }
        for (int length : new int[]{100, 100_000}) {
            var values = new TYPE[length];
            for (int i = 0; i < length; i++) {
                values[i] = (TYPE) (random.nextLong() & ((1L << WIDTH) - 1));
            }
            var reference = new experiment.reference.TableBuilder(3);
            reference.setInt64(42);
            reference.setUintWIDTHArray(values);
            reference.setFloat64(1.5);
            var bytes = table_VARIANT_WIDTH(values);
            require(Arrays.equals(bytes, reference.bytes()));
            var read = new experiment.VARIANT.ByteBuffer(bytes);
            require(Arrays.equals(read.getUintWIDTHArray(read.rootOffset(1)), values));
            require(read.getInt64(read.rootOffset(0)) == 42);
            require(read.getFloat64(read.rootOffset(2)) == 1.5);
        }
    }
// END KERNEL
}
