// Readers read a nested table's offsets as wide as its message's, while
// tables are written with 32-bit offsets

message Offset8 (offset_size: 8) {
    pair: Pair;
}

message Offset16 (offset_size: 16, sized) {
    label: string;
    pairs: [Pair];
}

table Pair {
    first: float32;
    second: float32;
}
