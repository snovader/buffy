// Readers read a nested table's offsets as of its message's offset type,
// while tables are written with uint32 offsets

message Offset8 (offset_type: uint8) {
    pair: Pair;
}

message Offset16 (offset_type: uint16, sized) {
    label: string;
    pairs: [Pair];
}

table Pair {
    first: float32;
    second: float32;
}
