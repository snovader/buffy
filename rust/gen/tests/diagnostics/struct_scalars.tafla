// The paths from a struct to its scalars, such as `a.b`, take at most 1024
// fields in all. Each of these structs holds two of the one before, which
// doubles its scalars and adds a field to each path: `S6` has 128 scalars
// through paths of 7 fields, which take 896, `S7` is the first whose paths
// take too many, and the error points at it rather than at the structs that
// hold it. `S15` takes 65536 bytes, which a struct can, but its generated
// code would name 65536 scalars through paths of 16 fields.

struct S0 { a: uint8; b: uint8; }
struct S1 { a: S0; b: S0; }
struct S2 { a: S1; b: S1; }
struct S3 { a: S2; b: S2; }
struct S4 { a: S3; b: S3; }
struct S5 { a: S4; b: S4; }
struct S6 { a: S5; b: S5; }
struct S7 { a: S6; b: S6; }
struct S8 { a: S7; b: S7; }
struct S9 { a: S8; b: S8; }
struct S10 { a: S9; b: S9; }
struct S11 { a: S10; b: S10; }
struct S12 { a: S11; b: S11; }
struct S13 { a: S12; b: S12; }
struct S14 { a: S13; b: S13; }
struct S15 { a: S14; b: S14; }

// 32 rows of 16 scalars: the paths of `Grid` take 1024 fields, and those of
// `Edged`, 1025. `Wrapped` has the scalars of `Grid`, but through paths of
// another field each, which take 1536.
struct Row {
    c0: float32; c1: float32; c2: float32; c3: float32;
    c4: float32; c5: float32; c6: float32; c7: float32;
    c8: float32; c9: float32; c10: float32; c11: float32;
    c12: float32; c13: float32; c14: float32; c15: float32;
}

struct Grid {
    r0: Row; r1: Row; r2: Row; r3: Row; r4: Row; r5: Row; r6: Row; r7: Row;
    r8: Row; r9: Row; r10: Row; r11: Row; r12: Row; r13: Row; r14: Row; r15: Row;
    r16: Row; r17: Row; r18: Row; r19: Row; r20: Row; r21: Row; r22: Row; r23: Row;
    r24: Row; r25: Row; r26: Row; r27: Row; r28: Row; r29: Row; r30: Row; r31: Row;
}

struct Edged {
    r0: Row; r1: Row; r2: Row; r3: Row; r4: Row; r5: Row; r6: Row; r7: Row;
    r8: Row; r9: Row; r10: Row; r11: Row; r12: Row; r13: Row; r14: Row; r15: Row;
    r16: Row; r17: Row; r18: Row; r19: Row; r20: Row; r21: Row; r22: Row; r23: Row;
    r24: Row; r25: Row; r26: Row; r27: Row; r28: Row; r29: Row; r30: Row; r31: Row;
    edge: float32;
}

struct Wrapped {
    grid: Grid;
}

table Holder {
    grid: Grid;
    edged: Edged;
    wrapped: Wrapped;
}
