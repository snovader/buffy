{
    "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
    // Biome's configuration lies in typescript/. This root lets Biome find it
    // from here too, as editors run it, and formats this file the same way
    "files": {
        "includes": ["typescript/**"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4
    }
}
