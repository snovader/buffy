// Messages in every layout: each offset type, uint8, uint16 and uint32, with
// and without the table's length and a version in its header. Their versions
// are zero or the largest that their offset type holds.

/// `uint8` offsets, for tables of up to 255 bytes
message Uint8Offsets (offset_type: uint8) {
    id: uint32;
    name: string;
    values: [uint16];
}

/// `uint8` offsets, after the table's length
message Uint8OffsetsSized (sized, offset_type: uint8) {
    id: uint32;
    name: string;
    values: [uint16];
}

/// `uint8` offsets, after the largest version they hold
message Uint8OffsetsVersioned (offset_type: uint8, version: 255) {
    id: uint32;
    name: string;
    values: [uint16];
}

/// `uint8` offsets, after the table's length and version zero
message Uint8OffsetsSizedVersioned (version: 0, sized, offset_type: uint8,) {
    id: uint32;
    name: string;
    values: [uint16];
}

/// `uint16` offsets, for tables of up to 65,535 bytes
message Uint16Offsets (offset_type: uint16) {
    id: uint32;
    name: string;
    values: [uint16];
}

/// `uint16` offsets, after the table's length
message Uint16OffsetsSized (offset_type: uint16, sized) {
    id: uint32;
    name: string;
    values: [uint16];
}

/// `uint16` offsets, after the largest version they hold
message Uint16OffsetsVersioned (offset_type: uint16, version: 65535) {
    id: uint32;
    name: string;
    values: [uint16];
}

/// `uint16` offsets, after the table's length and a version
message Uint16OffsetsSizedVersioned (sized, version: 1, offset_type: uint16) {
    id: uint32;
    name: string;
    values: [uint16];
}

/// `uint32` offsets, the default, for tables of up to 4 GiB
message Uint32Offsets {
    id: uint32;
    name: string;
    values: [uint16];
}

/// `uint32` offsets, after the table's length
message Uint32OffsetsSized (sized) {
    id: uint32;
    name: string;
    values: [uint16];
}

/// `uint32` offsets, after the largest version they hold
message Uint32OffsetsVersioned (version: 4294967295) {
    id: uint32;
    name: string;
    values: [uint16];
}

/// `uint32` offsets, after the table's length and a version
message Uint32OffsetsSizedVersioned (sized, version: 2, offset_type: uint32) {
    id: uint32;
    name: string;
    values: [uint16];
}
